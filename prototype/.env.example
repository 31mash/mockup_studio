# Copy to .env.local (git ignores it) and fill in. Read only by the local
# server that `npm run dev` and `npm run preview` start; never sent to the page.

# A Hugging Face read token: https://huggingface.co/settings/tokens
# Generative angles run on a ZeroGPU Space and use this account's GPU time.
HF_TOKEN=

# Optional. The camera-angle Space to call, as owner/name or the URL of any
# Gradio app with the same /infer_camera_edit endpoint (for example your own
# duplicate of the Space, or one running on your GPU).
# HF_ANGLE_SPACE=multimodalart/qwen-image-multiple-angles-3d-camera

# Optional. Extra host names allowed to call the local server, comma
# separated, when you open the studio from another device (vite --host).
# MOCKUP_ALLOWED_HOSTS=

# Testing only: `mock` returns your photo unchanged, with no network.
# MOCKUP_ANGLES=mock
